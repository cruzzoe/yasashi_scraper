DEEPSEEK_API_KEY=
# Override only if you want a specific current DeepSeek model.
DEEPSEEK_MODEL=deepseek-chat
# Official OpenAI-compatible endpoint; normally leave unchanged.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Versioned copy generated by NihongoPro's `npm run data:export-grammar-index`.
NIHONGOPRO_GRAMMAR_INDEX=./data/nihongopro-grammar-index.json
NHK_EASY_URL=https://news.web.nhk/news/easy/
# NHK area option value (0-53); 18 is Tokyo. Set this to your actual area.
NHK_AREA_INDEX=18
SCRAPER_OUTPUT=./output
SCRAPER_BROWSER_STATE=./browser-state
# Optional when Chromium/Chrome is already installed system-wide.
SCRAPER_CHROMIUM_EXECUTABLE=
PUBLISH_SSH_TARGET=publisher@example-host
PUBLISH_SSH_KEY=~/.ssh/nhk-reader-publisher
PUBLISH_INCOMING_PATH=/var/lib/nhk-reader/incoming
PUBLISH_COMMAND=sudo -u nhkreader /usr/local/bin/nhk-reader-publish
