# Keep this repository limited to the core scraper, its tests, and runtime inputs.
# Everything else (including .env, SSH keys, extra/, output/, browser-state/,
# virtual environments, caches, and deployment helpers) stays local.
/*
!/.gitignore
!/.env.example
!/nhk_easy_scraper.py
!/audio_alignment.py
!/models.py
!/requirements.txt
!/data/
!/tests/

/data/*
!/data/nihongopro-grammar-index.json

__pycache__/
.pytest_cache/
